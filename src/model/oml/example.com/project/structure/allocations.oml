@dc:title "ALAN Budget Allocations"
@dc:description "Mass and power budgets issued to components, and their decomposition. Owner: mission systems engineer. Changes when a budget is re-apportioned, which is a different event from a mass estimate maturing."
description <http://example.com/project/structure/allocations#> as allocations {

    uses    <http://purl.org/dc/elements/1.1/> as dc
    uses    <http://example.com/method/vocabulary#> as alan
    extends <http://example.com/project/structure/components#> as components

    @dc:description "System dry mass and orbit-average power budget."
    @alan:sourceDocument "TrueSightSAT sections 3.3 (4.0 kg dry mass) and 5.2 (18.44 W orbit-average generation)"
    instance SystemAllocation : alan:Allocation [
        alan:allocatedTo components:CubesatWhiteBox
        alan:allocatedMass 4.0
        alan:allocatedPower 18.44
    ]

    @dc:description "ADCS subsystem budget. The asserted part masses total 0.585 kg and exceed this figure; the overrun is reported by the part-budget page, not hidden in a README."
    @alan:sourceDocument "TrueSightSAT Table 14, subsystem total row"
    instance ADCSAllocation : alan:Allocation [
        alan:allocatedTo components:ADCSSubsystem
        alan:derivesFrom SystemAllocation
        alan:allocatedMass 0.531
        alan:allocatedPower 2.7
    ]

    @dc:description "Payload share of the system budget."
    @alan:sourceDocument "TrueSightSAT Table 14"
    instance PayloadAllocation : alan:Allocation [
        alan:allocatedTo components:PayloadSubsystem
        alan:derivesFrom SystemAllocation
        alan:allocatedMass 0.112
        alan:allocatedPower 9.0
    ]

    @dc:description "Structural subsystem budget, set to the vendor figure for the 3U structure it is built from. Carries no power."
    @alan:sourceDocument "SatCatalog, ISISPACE 3U structure (304.3 g primary plus secondary)"
    instance StructuralAllocation : alan:Allocation [
        alan:allocatedTo components:StructuralSubsystem
        alan:derivesFrom SystemAllocation
        alan:allocatedMass 0.3043
        alan:allocatedPower 0.0
    ]

}
