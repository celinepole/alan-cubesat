@dc:title "Alan Cubesat Description"
@dc:description "The Alan Cubesat ontologies."
description <https://example.com/project/description#> as myproject-desc {
    uses <http://purl.org/dc/elements/1.1/> as dc
    uses <https://example.com/method/vocabulary#> as method

    @dc:description "An example instance — replace it with your own data."
    instance ComponentA : method:Component [
        method:name "Component A"
    ]

    instance ComponentB : method:Component [
        method:name "Component B"
        method:dependsOn ComponentA
    ]
}
